set(CMAKE_SYSTEM_NAME XS3A)
set(CMAKE_SYSTEM_VERSION 0.0.1)

if(DEFINED ENV{XMOS_TOOL_PATH} AND NOT "$ENV{XMOS_TOOL_PATH}" STREQUAL "")
    set(XMOS_BIN_PATH "$ENV{XMOS_TOOL_PATH}/bin")

    set(CMAKE_C_COMPILER "${XMOS_BIN_PATH}/xcc")
    set(CMAKE_XC_COMPILER "${XMOS_BIN_PATH}/xcc")
    set(CMAKE_CXX_COMPILER  "${XMOS_BIN_PATH}/xcc")
    set(CMAKE_ASM_COMPILER  "${XMOS_BIN_PATH}/xcc")
    set(CMAKE_AR "${XMOS_BIN_PATH}/xmosar" CACHE FILEPATH "Archiver" FORCE)
    set(CMAKE_C_COMPILER_AR "${XMOS_BIN_PATH}/xmosar")
    set(CMAKE_XC_COMPILER_AR "${XMOS_BIN_PATH}/xmosar")
    set(CMAKE_CXX_COMPILER_AR "${XMOS_BIN_PATH}/xmosar")
    set(CMAKE_ASM_COMPILER_AR "${XMOS_BIN_PATH}/xmosar")
else()
    message(FATAL_ERROR "XMOS_TOOL_PATH is not set; source XTC SetEnv first")
endif()

set(CMAKE_C_COMPILER_FORCED TRUE)
set(CMAKE_XC_COMPILER_FORCED TRUE)
set(CMAKE_CXX_COMPILER_FORCED TRUE)
set(CMAKE_ASM_COMPILER_FORCED TRUE)
set(CMAKE_C_FLAGS "-march=xs3a" CACHE STRING "C Compiler Base Flags")
set(CMAKE_CXX_FLAGS "-march=xs3a -std=c++11" CACHE STRING "C++ Compiler Base Flags")
set(CMAKE_ASM_FLAGS "-march=xs3a" CACHE STRING "ASM Compiler Base Flags")
set(CMAKE_EXECUTABLE_SUFFIX_C ".xe" CACHE INTERNAL "" FORCE)
set(CMAKE_EXECUTABLE_SUFFIX_CXX ".xe" CACHE INTERNAL "" FORCE)
set(CMAKE_EXECUTABLE_SUFFIX_ASM ".xe" CACHE INTERNAL "" FORCE)

if( NOT ( DEFINED XCORE_TARGET ) )
  set( XCORE_TARGET "XCORE-AI-EXPLORER" CACHE STRING "xCore hardware target" )
endif()

message(STATUS "XCORE_TARGET is ${XCORE_TARGET}" )
